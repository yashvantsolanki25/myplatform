# Local development defaults only. Replace both passwords before deployment.
MYSQL_ROOT_PASSWORD=local-root-password
MYSQL_PASSWORD=local-app-password
MYPLATFORM_PORT=8080

# Optional: set this to a 64-character hex key for explicit key management.
# If unset, the app generates /data/secret.key in the persistent app-data volume.
# Generate with: openssl rand -hex 32
MYPLATFORM_ENCRYPTION_KEY=e67d59e5801011a09f05de9760b0251ca9c704c3831abd15c0bf25db85419d7e
